<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"/>
<link crossorigin="" href="https://fonts.gstatic.com/" rel="preconnect"/>
<link as="style" href="https://fonts.googleapis.com/css2?display=swap&amp;family=Lexend%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" onload="this.rel='stylesheet'" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Icons" rel="stylesheet"/>
<title>QuizGenius - AI Quiz Generator</title>
<link href="data:image/x-icon;base64," rel="icon" type="image/x-icon"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<style type="text/tailwindcss">
      :root {
        --primary-color: #1994e6;
        --secondary-color: #f0f3f4;
        --text-primary: #111518;
        --text-secondary: #637988;
        --background-color: #ffffff;
        --border-color: #dce1e5;
      }
      body {
        font-family: "Lexend", "Noto Sans", sans-serif;
      }
    </style>
</head>
<body class="bg-[var(--background-color)] text-[var(--text-primary)]">
<div class="relative flex size-full min-h-screen flex-col group/design-root overflow-x-hidden">
<div class="layout-container flex h-full grow flex-col">
<header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-[var(--border-color)] px-10 py-4">
<div class="flex items-center gap-3 text-[var(--text-primary)]">
<div class="w-8 h-8 text-[var(--primary-color)]">
<svg fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
<path d="M36.7273 44C33.9891 44 31.6043 39.8386 30.3636 33.69C29.123 39.8386 26.7382 44 24 44C21.2618 44 18.877 39.8386 17.6364 33.69C16.3957 39.8386 14.0109 44 11.2727 44C7.25611 44 4 35.0457 4 24C4 12.9543 7.25611 4 11.2727 4C14.0109 4 16.3957 8.16144 17.6364 14.31C18.877 8.16144 21.2618 4 24 4C26.7382 4 29.123 8.16144 30.3636 14.31C31.6043 8.16144 33.9891 4 36.7273 4C40.7439 4 44 12.9543 44 24C44 35.0457 40.7439 44 36.7273 44Z" fill="currentColor"></path>
</svg>
</div>
<h1 class="text-2xl font-bold tracking-tighter">QuizGenius</h1>
</div>
<nav class="hidden md:flex items-center gap-8">
<a class="text-sm font-medium hover:text-[var(--primary-color)] transition-colors" href="#">Dashboard</a>
<a class="text-sm font-medium hover:text-[var(--primary-color)] transition-colors" href="#">Quizzes</a>
<a class="text-sm font-medium hover:text-[var(--primary-color)] transition-colors" href="#">Lessons</a>
<a class="text-sm font-medium hover:text-[var(--primary-color)] transition-colors" href="#">Resources</a>
</nav>
<div class="flex items-center gap-4">
<button class="flex items-center justify-center rounded-full h-10 w-10 bg-[var(--secondary-color)] text-[var(--text-primary)] hover:bg-gray-200 transition-colors">
<span class="material-icons text-xl">notifications</span>
</button>
<div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDstUGNmESggRlNgZa1k0rlgNJCBKCQ-iIEv5azS1y4UwEV2COV7yw92Vjj9kTKYFd_9fh4sBnJXr3ZSvOJDM9mPCeXUkaGQU6VC7Y3RlLfQ6Q6reSPGctySNdyXz8JernC1qya9e4Rfh9dKi2GfGJdviY5IvZ8en3txto3A37V0Hmt21bTEah9bybtlkfMqMuadt7Y8wxfQJydba4tS0-OBcZ9uam2BoF5Dqx-yvlConIfhOgKrTZ9xARV9vr5C0zzQoH0WsIrV2Hv");'></div>
</div>
</header>
<main class="flex-1 grid md:grid-cols-3 lg:grid-cols-[1fr_3fr] gap-8 p-8">
<aside class="col-span-3 md:col-span-1 bg-gray-50 rounded-lg p-6 h-fit">
<h2 class="text-2xl font-bold mb-6">Quiz Settings</h2>
<div class="space-y-6">
<div>
<label class="block text-sm font-medium text-[var(--text-secondary)] mb-2" for="quiz-topic">Quiz Topic</label>
<input class="form-input flex w-full rounded-md border-[var(--border-color)] bg-white h-12 px-4 text-base placeholder:text-gray-400 focus:border-[var(--primary-color)] focus:ring-1 focus:ring-[var(--primary-color)] transition" id="quiz-topic" placeholder="e.g., Photosynthesis, World War II" value=""/>
</div>
<div>
<label class="block text-sm font-medium text-[var(--text-secondary)] mb-2" for="difficulty">Difficulty</label>
<select class="form-select flex w-full rounded-md border-[var(--border-color)] bg-white h-12 px-4 text-base focus:border-[var(--primary-color)] focus:ring-1 focus:ring-[var(--primary-color)] transition" id="difficulty">
<option>Beginner</option>
<option>Intermediate</option>
<option>Advanced</option>
</select>
</div>
<button class="flex w-full items-center justify-center rounded-md h-12 px-4 bg-[var(--primary-color)] text-white text-base font-bold hover:bg-blue-700 transition-colors">
<span class="material-icons mr-2">auto_awesome</span>
<span>Generate Quiz</span>
</button>
</div>
</aside>
<section class="col-span-3 md:col-span-2 lg:col-span-1">
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6">
<div>
<h1 class="text-3xl font-bold">Generated Quiz</h1>
<p class="text-[var(--text-secondary)] mt-1">Review, edit, and manage your AI-generated questions.</p>
</div>
<div class="flex gap-2 mt-4 sm:mt-0">
<button class="flex items-center justify-center rounded-md h-10 px-4 bg-[var(--secondary-color)] text-[var(--text-primary)] text-sm font-bold hover:bg-gray-200 transition-colors">
<span class="material-icons mr-2 text-base">refresh</span>
<span>Regenerate</span>
</button>
<button class="flex items-center justify-center rounded-md h-10 px-4 bg-[var(--primary-color)] text-white text-sm font-bold hover:bg-blue-700 transition-colors">
<span class="material-icons mr-2 text-base">add</span>
<span>Add to Lesson</span>
</button>
</div>
</div>
<div class="space-y-6">
<div class="rounded-lg border border-[var(--border-color)] bg-white shadow-sm overflow-hidden">
<div class="p-5">
<div class="flex items-start justify-between">
<div class="flex-1">
<div class="flex items-center gap-3 mb-3">
<span class="material-icons text-[var(--primary-color)]">list_alt</span>
<p class="text-sm font-medium text-[var(--text-secondary)]">Multiple Choice</p>
</div>
<p class="text-lg font-semibold mb-3">What is the capital of France?</p>
<div class="space-y-2 text-sm text-[var(--text-secondary)]">
<p>A. Berlin</p>
<p class="font-bold text-green-600">B. Paris</p>
<p>C. Rome</p>
<p>D. Madrid</p>
</div>
</div>
<div class="flex items-center gap-2">
<button class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors text-[var(--text-secondary)]">
<span class="material-icons text-lg">edit</span>
</button>
<button class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors text-[var(--text-secondary)]">
<span class="material-icons text-lg">delete</span>
</button>
</div>
</div>
</div>
</div>
<div class="rounded-lg border border-[var(--border-color)] bg-white shadow-sm overflow-hidden">
<div class="p-5">
<div class="flex items-start justify-between">
<div class="flex-1">
<div class="flex items-center gap-3 mb-3">
<span class="material-icons text-[var(--primary-color)]">check_circle_outline</span>
<p class="text-sm font-medium text-[var(--text-secondary)]">True/False</p>
</div>
<p class="text-lg font-semibold mb-3">The Earth is flat.</p>
<p class="text-sm text-[var(--text-secondary)]">Answer: <span class="font-bold text-red-600">False</span></p>
</div>
<div class="flex items-center gap-2">
<button class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors text-[var(--text-secondary)]">
<span class="material-icons text-lg">edit</span>
</button>
<button class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors text-[var(--text-secondary)]">
<span class="material-icons text-lg">delete</span>
</button>
</div>
</div>
</div>
</div>
<div class="rounded-lg border border-[var(--border-color)] bg-white shadow-sm overflow-hidden">
<div class="p-5">
<div class="flex items-start justify-between">
<div class="flex-1">
<div class="flex items-center gap-3 mb-3">
<span class="material-icons text-[var(--primary-color)]">short_text</span>
<p class="text-sm font-medium text-[var(--text-secondary)]">Short Answer</p>
</div>
<p class="text-lg font-semibold mb-3">Explain the concept of photosynthesis.</p>
<textarea class="form-textarea w-full mt-2 rounded-md border-[var(--border-color)] text-sm text-[var(--text-secondary)]" placeholder="Type the expected answer here..." rows="3"></textarea>
</div>
<div class="flex items-center gap-2">
<button class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors text-[var(--text-secondary)]">
<span class="material-icons text-lg">edit</span>
</button>
<button class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors text-[var(--text-secondary)]">
<span class="material-icons text-lg">delete</span>
</button>
</div>
</div>
</div>
</div>
</div>
</section>
</main>
</div>
</div>

</body></html>
